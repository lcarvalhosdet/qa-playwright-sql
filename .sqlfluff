[sqlfluff]
dialect = postgres
max_line_length = 120
# queries.sql is larger than the default 20 KB limit, which would skip it silently.
large_file_skip_byte_limit = 0
# Rules left out on purpose, because the project follows another convention:
#   LT01  column definitions are aligned with extra spaces
#   LT02  continuation lines (VALUES rows, CREATE TRIGGER clauses) are indented;
#         the fixer would move them back to the left margin
#   LT09  short SELECTs keep their targets on one line
#   LT14  short queries keep WHERE on the same line
#   CP03  built-in functions are upper case (COUNT, SUM) and the project's own
#         are lower case (order_total); the rule cannot tell them apart
#   RF04  domain words such as name, status, level, day and action are column names
#   AM05  a plain JOIN means INNER JOIN, as in the PostgreSQL docs
#   ST09  JOIN conditions put the newly joined table first
exclude_rules = LT01, LT02, LT09, LT14, CP03, RF04, AM05, ST09

[sqlfluff:indentation]
tab_space_size = 2
indented_ctes = false

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper
# A type the project created, named like its tables.
ignore_words = order_status

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower
# The row variables of a trigger, written in upper case in CREATE TRIGGER ... WHEN,
# and PUBLIC, the keyword for every role in GRANT and REVOKE.
ignore_words = OLD,NEW,PUBLIC

[sqlfluff:rules:aliasing.table]
aliasing = implicit
