{
  // Playwright compiles the tests itself without checking types.
  // This config is only for `npm run typecheck` (tsc --noEmit).
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    // api/src imports its own files with the .ts extension, so Node can run
    // it directly with type stripping (npm run api), without a build step.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "db/**/*.ts", "tests/**/*.ts", "pages/**/*.ts", "playwright.config.ts", "global-setup.ts"]
}
